{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/cartography-emergency",
  "version": "0.1.7",
  "description": "An add-on of @mark1russell7/cartography: the layers of evacuation zones, evacuation routes and shelters, in black and white.",
  "keywords": [
    "map",
    "cartography",
    "emergency",
    "evacuation",
    "shelter"
  ],
  "homepage": "https://github.com/mark1russell7/cartography/tree/main/packages/cartography-emergency#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/cartography/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/cartography.git",
    "directory": "packages/cartography-emergency"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/cartography": "workspace:*"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "tsdown": "^0.23.7"
  }
}
