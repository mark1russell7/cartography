{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/cartography",
  "version": "0.1.3",
  "description": "Maps as data: a frame, layers with filters and black and white styles, and a render to SVG in millimetres with a scale bar, a north arrow, a legend and the attribution of each source.",
  "keywords": [
    "map",
    "cartography",
    "svg",
    "print",
    "geojson",
    "scale-bar",
    "openstreetmap"
  ],
  "homepage": "https://github.com/mark1russell7/cartography/tree/main/packages/cartography#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/cartography/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/cartography.git",
    "directory": "packages/cartography"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/geo": "^0.5.4",
    "@mark1russell7/text": "^0.0.17"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@mark1russell7/layout-contract": "^0.11.1",
    "@mark1russell7/rigor-generators": "^0.2.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
